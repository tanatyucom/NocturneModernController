<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>2.0.3</Version>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>NocturneModernController</AssemblyName>
    <RootNamespace>NocturneModernController</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GameDir)' == ''">
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\smt3hd</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Retained as crash-investigation source only; never compile this native hook. -->
    <Compile Remove="src\NativePadCheckHook.cs" />
    <Compile Remove="helper\**\*.cs" />
    <Compile Remove="settings\**\*.cs" />
    <Compile Remove="tools\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="analysis\**\*.cs" />
    <!-- External gameplay mods built as their own projects. -->
    <Compile Remove="mods\**\*.cs" />
    <Compile Remove="src\FieldCameraMainProbe.cs" />
    <Compile Remove="src\RightStickTurnInput.cs" />
    <Compile Remove="src\XInputReader.cs" />
    <!-- Investigation-only telemetry retained in source, excluded from releases. -->
    <Compile Remove="src\NativeMouseVerticalCameraPoc.cs" />
    <Compile Remove="src\VerticalCameraStateProbe.cs" />
    <Compile Remove="src\VerticalCameraInjectionPatch.cs" />
    <Compile Remove="src\ForceEncounterTelemetry.cs" />
    <Compile Remove="src\CameraVectorProbe.cs" />
    <Compile Remove="src\AnalogChannelTelemetry.cs" />
    <!-- Native GAME binding write PoC (Y<->X round trip succeeded 2026-09-26) and its
         diagnostics. Kept as the verified reference for the Settings implementation;
         see investigations/NATIVE_GAMEPAD_EDIT_DESIGN_20260924.md §12-§13. -->
    <Compile Remove="src\GameBindingWritePoc.cs" />
    <Compile Remove="src\GameBindingDiagnosticProbe.cs" />
    <Compile Remove="src\UiRefreshDiagnosticProbe.cs" />
    <!-- Read-only A/B probes from the GAME binding read investigation (PadCfg/CommonConfig
         falsified, GetConfigGamePad confirmed). Production reads go through
         ModernControllerApi.CaptureGameActionBindingsRaw instead. -->
    <Compile Remove="src\PadCfgDiagnosticProbe.cs" />
    <Compile Remove="src\GameBindingProbe.cs" />

    <Reference Include="MelonLoader">
      <HintPath>$(GameDir)\MelonLoader\net6\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\MelonLoader\net6\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(GameDir)\MelonLoader\net6\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
