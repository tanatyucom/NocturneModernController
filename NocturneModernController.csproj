<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>NocturneModernController</AssemblyName>
    <RootNamespace>NocturneModernController</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GameDir)' == ''">
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\smt3hd</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Retained as crash-investigation source only; never compile this native hook. -->
    <Compile Remove="src\NativePadCheckHook.cs" />
    <Compile Remove="helper\**\*.cs" />
    <Compile Remove="settings\**\*.cs" />
    <Compile Remove="tools\**\*.cs" />
    <Compile Remove="analysis\**\*.cs" />
    <!-- Evidence/source snapshots saved under docs/research are read-only copies for
         investigation history, never build inputs. -->
    <Compile Remove="docs\**\*.cs" />
    <Compile Remove="src\FieldCameraMainProbe.cs" />
    <Compile Remove="src\RightStickTurnInput.cs" />
    <Compile Remove="src\XInputReader.cs" />
    <!-- Investigation-only telemetry retained in source, excluded from releases. -->
    <!-- Chapter 118: src\NativeMouseVerticalCameraPoc.cs re-included in the build to
         re-enable its two dormant, read-only Harmony patches (NativeMouseDragCheckPatch,
         NativeMouseDirectionPatch) for the Guide-hold camera-speed investigation. -->
    <Compile Remove="src\VerticalCameraStateProbe.cs" />
    <Compile Remove="src\VerticalCameraInjectionPatch.cs" />
    <Compile Remove="src\ForceEncounterTelemetry.cs" />
    <Compile Remove="src\CameraVectorProbe.cs" />
    <Compile Remove="src\AnalogChannelTelemetry.cs" />

    <Reference Include="MelonLoader">
      <HintPath>$(GameDir)\MelonLoader\net6\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\MelonLoader\net6\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(GameDir)\MelonLoader\net6\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Third-party mod, referenced only for a read-only Root26 diagnostic
         call-count probe (Root26KernelLoopFrequencyProbe). Not required for
         any core functionality; that probe's Harmony registration is
         wrapped in try/catch so this mod still loads fine if the
         third-party DLL is absent/renamed. -->
    <Reference Include="Nocturne Framerate Mod">
      <HintPath>$(GameDir)\Mods\Nocturne Framerate Mod.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
