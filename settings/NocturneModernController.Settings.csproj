         implementation (also linked into NocturneModernController.csproj
         and used by tools/TaskSchedulerBroker's P1 acceptance-test
         harness); it is linked in here rather than duplicated. -->
    <Compile Include="..\tools\TaskSchedulerBroker\BrokerTaskService.cs" />
  </ItemGroup>
</Project>
